{
  "name": "castle-mystery",
  "private": true,
  "version": "2.4.8",
  "type": "module",
  "scripts": {
    "cmgen": "node --experimental-strip-types scripts/cmgen.ts",
    "solve": "node --experimental-strip-types  scripts/solve.ts",
    "evaluate": "node --experimental-strip-types scripts/evaluateLevel.ts",
    "dev": "vite",
    "dev-gen": "vite --mode dev-gen",
    "build": "tsc && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "check:unused": "knip",
    "preview": "vite preview",
    "setup-portal-workflows": "mkdir -p .github/workflows && cp -r ./node_modules/decent-portal/github-workflows/*.yml .github/workflows",
    "test": "vitest --run src",
    "test:all": "vitest --run src --reporter=dot --no-file-parallelism --maxWorkers=1",
    "test:file": "vitest run --reporter=dot --no-file-parallelism --maxWorkers=1",
    "testscripts": "vitest --run scripts",
    "test:watch": "vitest --watch src",
    "test:coverage": "vitest --coverage --run src"
  },
  "dependencies": {
    "decent-portal": "^2.4.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "knip": "^5.88.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
